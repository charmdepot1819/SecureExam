{
  "name": "exam-online",
  "version": "0.1.0",
  "private": true,
  "description": "An LMS-style exam and quiz creator with educator mode, auto-grading, manual grading and a gradebook. Runs free on Firebase Spark + Vercel Hobby.",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "emulators": "npx firebase-tools@14.27.0 emulators:start --only auth,firestore --project demo-exam-online",
    "dev:emulator": "dotenv -e .env.emulator -- next dev",
    "build:emulator": "dotenv -e .env.emulator -- next build",
    "start:emulator": "dotenv -e .env.emulator -- next start",
    "seed": "node --no-warnings --experimental-strip-types scripts/seed.ts",
    "seed:emulator": "dotenv -e .env.emulator -- node --no-warnings --experimental-strip-types scripts/seed.ts",
    "deploy:rules": "npx firebase-tools@14.27.0 deploy --only firestore",
    "test": "node --no-warnings --experimental-strip-types --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "firebase": "11.10.0",
    "firebase-admin": "13.10.0",
    "next": "15.5.29",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "dotenv-cli": "8.0.0",
    "typescript": "5.9.2"
  }
}

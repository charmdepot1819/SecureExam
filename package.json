{
  "name": "exam-online",
  "version": "0.1.0",
  "private": true,
  "description": "An LMS-style exam and quiz creator with educator mode, auto-grading, manual grading and a gradebook.",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
